<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ide_surface_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Workspace &amp; Analysis Configuration"
        android:textColor="@color/ide_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Project Source Directories (separated by commas)"
        android:textColor="@color/ide_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etSourceDirs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_rounded_card"
        android:hint="src/main/kotlin, src/main/java"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ide_text_primary"
        android:textColorHint="@color/ide_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Editor Font Size (sp)"
        android:textColor="@color/ide_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etFontSize"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_rounded_card"
        android:hint="14"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="14"
        android:textColor="@color/ide_text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Analysis &amp; Completion Engine"
        android:textColor="@color/ide_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvAnalysisStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="⚡ Kotlin PSI &amp; Semantic Diagnostics: ACTIVE"
        android:textColor="@color/status_success"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
