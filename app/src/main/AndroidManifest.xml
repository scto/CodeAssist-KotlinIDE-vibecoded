<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Logs nach /storage/emulated/0/CodeAssistLSP (Fallback: Android/data/<pkg>/files/CodeAssistLSP) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".CodeAssistApp"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Crash-Anzeige in eigenem Prozess, unabhängig vom (abgestürzten) Haupt-Prozess -->
        <activity
            android:name=".diagnostics.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:label="CodeAssist Crash"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CodeAssist.Crash" />
    </application>

</manifest>
